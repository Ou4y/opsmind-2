# OpsMind Azure Student Staging Environment Template
# Safe template only. Do not put real secrets in this file.
# Store real values in Azure Key Vault or Azure Container App secrets.

# Frontend public API URLs
OPSMIND_FRONTEND_URL=https://<frontend-app>.<region>.azurestaticapps.net
OPSMIND_API_URL=https://<auth-app>.<region>.azurecontainerapps.io
OPSMIND_AUTH_URL=https://<auth-app>.<region>.azurecontainerapps.io
OPSMIND_TICKET_URL=https://<ticket-app>.<region>.azurecontainerapps.io
OPSMIND_WORKFLOW_API_URL=https://<workflow-app>.<region>.azurecontainerapps.io
OPSMIND_SLA_URL=https://<sla-app>.<region>.azurecontainerapps.io
OPSMIND_NOTIFICATION_URL=https://<notification-app>.<region>.azurecontainerapps.io/api/notifications
OPSMIND_INVENTORY_API_URL=https://<inventory-backend-app>.<region>.azurecontainerapps.io/api
OPSMIND_INVENTORY_BACKEND_URL=https://<inventory-backend-app>.<region>.azurecontainerapps.io
OPSMIND_INVENTORY_AI_API_URL=https://<inventory-ai-app>.<region>.azurecontainerapps.io
OPSMIND_AI_API_URL=https://<ticket-ai-app>.<region>.azurecontainerapps.io
OPSMIND_REPORT_API_URL=https://<reporting-app>.<region>.azurecontainerapps.io/analytics
OPSMIND_AGENTIC_AI_URL=https://<agentic-ai-app>.<region>.azurecontainerapps.io

# CORS / auth enforcement
CORS_ORIGIN=https://<frontend-app>.<region>.azurestaticapps.net
CORS_ORIGINS=https://<frontend-app>.<region>.azurestaticapps.net
INVENTORY_ENFORCE_AUTH=true
AUTH_SERVICE_URL=https://<auth-app>.<region>.azurecontainerapps.io
NOTIFICATION_SERVICE_URL=https://<notification-app>.<region>.azurecontainerapps.io/api/notifications
INVENTORY_APPROVAL_NOTIFICATION_ENABLED=true
AUTH_ENFORCE_HTTPS=true
JWT_SECRET=<set-in-azure-key-vault>
INTERNAL_API_TOKEN=<set-in-container-app-secret>

# MySQL-backed services: auth, ticket, workflow, SLA, agentic AI where used
MYSQL_HOST=<mysql-flexible-server>.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_USER=<set-in-container-app-secret>
MYSQL_PASSWORD=<set-in-azure-key-vault>
MYSQL_DATABASE_AUTH=<auth-db-name>
MYSQL_DATABASE_TICKETS=<tickets-db-name>
MYSQL_DATABASE_WORKFLOW=<workflow-db-name>
MYSQL_DATABASE_SLA=<sla-db-name>
MYSQL_DATABASE_AGENTIC_AI=<agentic-ai-db-name>
TICKET_DATABASE_URL=mysql://<user>:<password>@<mysql-flexible-server>.mysql.database.azure.com:3306/<tickets-db-name>?sslaccept=strict
SLA_DATABASE_URL=mysql://<user>:<password>@<mysql-flexible-server>.mysql.database.azure.com:3306/<sla-db-name>?sslaccept=strict
AGENTIC_AI_DATABASE_URL=mysql://<user>:<password>@<mysql-flexible-server>.mysql.database.azure.com:3306/<agentic-ai-db-name>?sslaccept=strict

# PostgreSQL-backed Inventory / Procurement / ITAM service
POSTGRES_HOST=<postgres-flexible-server>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=<set-in-container-app-secret>
POSTGRES_PASSWORD=<set-in-azure-key-vault>
POSTGRES_DB=opsmind_inventory_staging
DATABASE_URL=postgresql://<user>:<password>@<postgres-flexible-server>.postgres.database.azure.com:5432/opsmind_inventory_staging?sslmode=require
INVENTORY_DATABASE_URL=postgresql://<user>:<password>@<postgres-flexible-server>.postgres.database.azure.com:5432/opsmind_inventory_staging?sslmode=require

# Notification/reporting Mongo-compatible storage, if retained during staging
MONGO_URI=<set-in-container-app-secret-or-use-managed-alternative>
REPORTING_MONGO_URI=<set-in-container-app-secret-or-use-managed-alternative>

# Messaging
# Phase 1 may keep RabbitMQ inside Container Apps only for staging experiments.
# Recommended long-term staging/prod direction is Azure Service Bus.
RABBITMQ_URL=<set-in-container-app-secret-if-rabbitmq-used>
RABBITMQ_URI=<set-in-container-app-secret-if-rabbitmq-used>
AZURE_SERVICE_BUS_CONNECTION_STRING=<set-in-azure-key-vault>
AZURE_SERVICE_BUS_NAMESPACE=<service-bus-namespace>.servicebus.windows.net
EVENTS_EXCHANGE_NAME=opsmind.events
INVENTORY_EVENTS_EXCHANGE=opsmind.events

# AI / LLM mode
# Student-credit staging should start deterministic/fallback-first or hosted-provider mode.
LLM_PROVIDER=deterministic
AI_FALLBACK_MODE=deterministic
AI_DEBUG_RAW_OUTPUT=false
OLLAMA_BASE_URL=<not-recommended-for-student-azure-staging>
OLLAMA_MODEL=<optional-local-only>
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_RETRY_ATTEMPTS=1
GEMINI_API_KEY=<set-in-azure-key-vault-if-enabled>
GEMINI_MODEL=<set-if-enabled>

# Inventory AI scheduler / spec verification
INVENTORY_AI_DATA_DIR=/app/data
SCHEDULER_POLL_SECONDS=300
SPEC_LOOKUP_ENABLED=false
SERPAPI_API_KEY=<set-in-azure-key-vault-if-enabled>
SERPAPI_ENDPOINT=https://serpapi.com/search.json

# Mail / notifications
SMTP_HOST=<set-in-container-app-secret>
SMTP_PORT=587
SMTP_USER=<set-in-container-app-secret>
SMTP_PASSWORD=<set-in-azure-key-vault>
SMTP_FROM=no-reply@<your-domain>

# Monitoring
LOG_LEVEL=info
AZURE_LOG_ANALYTICS_WORKSPACE_ID=<set-in-container-app-secret>
APPLICATIONINSIGHTS_CONNECTION_STRING=<set-in-container-app-secret>

# Finance/supplier integration placeholders
FINANCE_PROVIDER=manual
SUPPLIER_PROVIDER=manual
EXTERNAL_FINANCE_API_URL=<set-only-if-configured>
EXTERNAL_FINANCE_API_KEY=<set-in-azure-key-vault>
EXTERNAL_SUPPLIER_API_URL=<set-only-if-configured>
EXTERNAL_SUPPLIER_API_KEY=<set-in-azure-key-vault>
