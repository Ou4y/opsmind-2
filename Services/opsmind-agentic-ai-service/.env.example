PORT=4010
SERVICE_NAME=opsmind-agentic-ai-service
NODE_ENV=development
DATABASE_URL=mysql://<db_user>:<db_password>@localhost:3307/agentic_ai_db

# Security secrets (must be set per environment)
JWT_SECRET=__SET_STRONG_JWT_SECRET__
INTERNAL_API_TOKEN=__SET_STRONG_INTERNAL_API_TOKEN__
ENDPOINT_AGENT_SHARED_SECRET=__SET_STRONG_ENDPOINT_AGENT_SHARED_SECRET__

# CORS
ALLOWED_ORIGINS=http://localhost:8085
CORS_ALLOW_CREDENTIALS=false

# Docs/debug controls
ENABLE_API_DOCS=true
ENABLE_AGENT_DEVICE_ENDPOINTS=false

# Rate limiting
AI_PLANNING_RATE_LIMIT_MAX=20
AI_ACTION_RATE_LIMIT_MAX=40
AGENT_DEVICE_RATE_LIMIT_MAX=120

# LLM runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
