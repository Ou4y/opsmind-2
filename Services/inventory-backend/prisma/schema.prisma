// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  LAPTOP           @map("laptop")
  DESKTOP          @map("desktop")
  TABLET           @map("tablet")
  SERVER           @map("server")
  MONITOR          @map("monitor")
  PERIPHERAL       @map("peripheral")
  KEYBOARD         @map("keyboard")
  ELECTRONICS      @map("electronics")
  PROJECTOR        @map("projector")
  SMARTBOARD       @map("smartboard")
  CAMERA           @map("camera")
  SPEAKER          @map("speaker")
  MICROPHONE       @map("microphone")
  ROUTER           @map("router")
  SWITCH           @map("switch")
  ACCESS_POINT     @map("access_point")
  FIREWALL         @map("firewall")
  PRINTER          @map("printer")
  SCANNER          @map("scanner")
  DESK             @map("desk")
  CHAIR            @map("chair")
  WHITEBOARD       @map("whiteboard")
  FILING_CABINET   @map("filing_cabinet")
  FURNITURE        @map("furniture")
  MICROSCOPE       @map("microscope")
  CENTRIFUGE       @map("centrifuge")
  OSCILLOSCOPE     @map("oscilloscope")
  THREE_D_PRINTER  @map("3d_printer")
  LAB_BENCH        @map("lab_bench")
  VEHICLE          @map("vehicle")
  GENERATOR        @map("generator")
  HVAC             @map("hvac")
  MAINTENANCE_TOOL @map("maintenance_tool")
}

enum AssetStatus {
  ACTIVE      @map("active")
  REPAIR      @map("repair")
  RETIRED     @map("retired")
  ASSIGNED    @map("assigned")
  MAINTENANCE @map("maintenance")
}

enum AssetCategory {
  ASSET      @map("asset")
  COMPONENT  @map("component")
  ACCESSORY  @map("accessory")
  CONSUMABLE @map("consumable")
  LICENSE    @map("license")
  SPARE_PART @map("spare_part")
}

enum AssetLifecycleStatus {
  IN_STOCK          @map("in_stock")
  ASSIGNED          @map("assigned")
  IN_USE            @map("in_use")
  UNDER_MAINTENANCE @map("under_maintenance")
  PENDING_REPAIR    @map("pending_repair")
  IN_TRANSIT        @map("in_transit")
  RESERVED          @map("reserved")
  RETIRED           @map("retired")
  DISPOSED          @map("disposed")
  LOST_STOLEN       @map("lost_stolen")
  EOL_EXPIRED       @map("eol_expired")
}

enum AssetCustodyStatus {
  UNASSIGNED @map("unassigned")
  CHECKED_OUT @map("checked_out")
  RETURNED   @map("returned")
}

enum AssetLocation {
  CENTRAL_WAREHOUSE @map("Central Warehouse")
  MAIN_BUILDING     @map("Main Building")
  K_BUILDING        @map("K Building")
  N_BUILDING        @map("N Building")
  S_BUILDING        @map("S Building")
  R_BUILDING        @map("R Building")
  PHARMACY_BUILDING @map("Pharmacy Building")
}

enum AssetDepartment {
  COMPUTER_SCIENCE @map("Computer Science")
  ENGINEERING      @map("Engineering")
  ARCHITECTURE     @map("Architecture")
  BUSINESS         @map("Business")
  MASS_COMM        @map("Mass Comm")
  ALSUN            @map("Alsun")
  PHARMACY         @map("Pharmacy")
  DENTISTRY        @map("Dentistry")
  UNASSIGNED       @map("Unassigned")
  GENERAL          @map("General")
}

enum TicketStatus {
  OPEN        @map("Open")
  IN_PROGRESS @map("In Progress")
  RESOLVED    @map("Resolved")
  CLOSED      @map("Closed")
}

enum TicketPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")
}

enum TicketType {
  HARDWARE @map("Hardware")
  SOFTWARE @map("Software")
  NETWORK  @map("Network")
  ACCESS   @map("Access")
  OTHER    @map("Other")
}

enum ProcurementRequestType {
  REPLACEMENT         @map("replacement")
  SPARE_STOCK         @map("spare_stock")
  CONSUMABLE_RESTOCK  @map("consumable_restock")
  LICENSE_RENEWAL     @map("license_renewal")
  NEW_PURCHASE        @map("new_purchase")
  MAINTENANCE_RELATED @map("maintenance_related")
  AUDIT_RELATED       @map("audit_related")
  OTHER               @map("other")
}

enum ProcurementRequestPriority {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")
}

enum ProcurementRequestStatus {
  DRAFT              @map("draft")
  SUBMITTED          @map("submitted")
  UNDER_REVIEW       @map("under_review")
  APPROVED           @map("approved")
  REJECTED           @map("rejected")
  ORDERED            @map("ordered")
  PARTIALLY_RECEIVED @map("partially_received")
  RECEIVED           @map("received")
  CLOSED             @map("closed")
  CANCELLED          @map("cancelled")
}

enum ProcurementRequestSource {
  MANUAL            @map("manual")
  AI_RECOMMENDATION @map("ai_recommendation")
  LOW_STOCK         @map("low_stock")
  EOL               @map("eol")
  AUDIT             @map("audit")
  MAINTENANCE       @map("maintenance")
  IMPORT            @map("import")
}

enum ProcurementApprovalDecision {
  SUBMIT        @map("submit")
  APPROVE       @map("approve")
  REJECT        @map("reject")
  CANCEL        @map("cancel")
  REOPEN        @map("reopen")
  MARK_ORDERED  @map("mark_ordered")
  MARK_RECEIVED @map("mark_received")
  CLOSE         @map("close")
  UPDATE        @map("update")
}

enum VendorQuoteStatus {
  PENDING  @map("pending")
  SELECTED @map("selected")
  REJECTED @map("rejected")
}

enum PurchaseOrderStatus {
  DRAFT              @map("draft")
  ISSUED             @map("issued")
  PARTIALLY_RECEIVED @map("partially_received")
  RECEIVED           @map("received")
  CANCELLED          @map("cancelled")
}

enum ReceivingCondition {
  GOOD             @map("good")
  DAMAGED          @map("damaged")
  PARTIAL          @map("partial")
  NEEDS_INSPECTION @map("needs_inspection")
}

enum ProcurementAssetRelationshipType {
  REPLACES          @map("replaces")
  REQUESTED_FOR     @map("requested_for")
  RELATED_TO        @map("related_to")
  CAUSED_BY_AUDIT   @map("caused_by_audit")
  CAUSED_BY_MAINTENANCE @map("caused_by_maintenance")
  EOL_REPLACEMENT   @map("eol_replacement")
  LOW_STOCK_RESTOCK @map("low_stock_restock")
  LICENSE_RENEWAL   @map("license_renewal")
}

enum ProcurementRecommendationReviewStatus {
  NEW       @map("new")
  REVIEWED  @map("reviewed")
  CONVERTED @map("converted")
  IGNORED   @map("ignored")
}

enum InventoryAbcClass {
  A            @map("a")
  B            @map("b")
  C            @map("c")
  UNCLASSIFIED @map("unclassified")
}

enum ProcurementFinanceStatus {
  NOT_SUBMITTED        @map("not_submitted")
  PENDING_BUDGET_REVIEW @map("pending_budget_review")
  BUDGET_APPROVED      @map("budget_approved")
  BUDGET_REJECTED      @map("budget_rejected")
  INVOICED             @map("invoiced")
  PAYMENT_PENDING      @map("payment_pending")
  PAID                 @map("paid")
  CANCELLED            @map("cancelled")
}

enum ProcurementRfqStatus {
  DRAFT     @map("draft")
  SENT      @map("sent")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")
}

model Asset {
  id             String          @id @default(uuid())
  customId       String          @unique
  name           String
  type           AssetType
  status         AssetStatus     @default(ACTIVE)
  lifecycleStatus AssetLifecycleStatus @default(IN_STOCK)
  category       AssetCategory   @default(ASSET)
  value          Decimal         @default(0)
  quantity       Int             @default(1)
  assignedUser   String?
  serialNumber   String?
  assetTag       String?
  manufacturerPartNumber String?
  location       AssetLocation
  department     AssetDepartment
  assignedToName String?
  assignedToUserId String?
  assignedDepartment String?
  checkoutDate DateTime?
  expectedReturnDate DateTime?
  returnedDate DateTime?
  custodyStatus AssetCustodyStatus @default(UNASSIGNED)
  purchaseDate DateTime?
  vendor String?
  purchaseCost Decimal?
  invoiceNumber String?
  purchaseOrderNumber String?
  warrantyStartDate DateTime?
  warrantyEndDate DateTime?
  replacementCost Decimal?
  specifications Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  histories             AssetHistory[]
  assetTickets          AssetTicket[]
  relatedTickets        Ticket[]
  lifecycleOutcome      AssetLifecycleOutcome?
  specSnapshots         AssetSpecSnapshot[]
  specEvidence          AssetSpecEvidence[]
  telemetrySamples      AssetTelemetrySample[]
  lifespanPredictions   AssetLifespanPrediction[]
  eolAssessments        AssetEolAssessment[]
  procurementCandidates AssetProcurementCandidate[]
  aiJobs                InventoryAiJob[]
  componentsAsParent    AssetComponent[]      @relation("AssetComponentParent")
  componentsAsChild     AssetComponent[]      @relation("AssetComponentChildAsset")
  lifecycleEvents       AssetLifecycleEvent[]
  maintenanceRecords    AssetMaintenanceRecord[]
  custodyEvents         AssetCustodyEvent[]
  relationshipsFrom     AssetRelationship[]   @relation("AssetRelationshipFrom")
  relationshipsTo       AssetRelationship[]   @relation("AssetRelationshipTo")

  @@map("assets")
}

model AssetComponent {
  id                     String   @id @default(uuid())
  parentAssetId          String
  childAssetId           String?
  componentName          String
  componentType          String
  brand                  String?
  model                  String?
  serialNumber           String?
  partNumber             String?
  status                 String   @default("installed")
  condition              String?
  installedAt            DateTime?
  removedAt              DateTime?
  reason                 String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parentAsset            Asset    @relation("AssetComponentParent", fields: [parentAssetId], references: [customId], onDelete: Cascade)
  childAsset             Asset?   @relation("AssetComponentChildAsset", fields: [childAssetId], references: [customId], onDelete: SetNull)
  lifecycleEvents        AssetLifecycleEvent[]
  maintenanceRecords     AssetMaintenanceRecord[]

  @@index([parentAssetId, status])
  @@index([childAssetId])
  @@index([serialNumber])
  @@map("asset_components")
}

model AssetLifecycleEvent {
  id            String   @id @default(uuid())
  assetId       String
  componentId   String?
  eventType     String
  oldValue      Json?
  newValue      Json?
  reason        String?
  notes         String?
  actor         String?
  createdAt     DateTime @default(now())

  asset         Asset          @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  component     AssetComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([componentId, createdAt])
  @@index([eventType, createdAt])
  @@map("asset_lifecycle_events")
}

model AssetMaintenanceRecord {
  id                  String   @id @default(uuid())
  assetId             String
  componentId         String?
  maintenanceType     String
  status              String   @default("completed")
  performedBy         String?
  performedAt         DateTime?
  nextMaintenanceDate DateTime?
  cost                Decimal?
  reason              String?
  notes               String?
  linkedTicketId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  asset               Asset          @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  component           AssetComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([componentId, createdAt])
  @@index([status, nextMaintenanceDate])
  @@map("asset_maintenance_records")
}

model AssetCustodyEvent {
  id                String   @id @default(uuid())
  assetId           String
  action            String
  assignedToName    String?
  assignedToUserId  String?
  assignedDepartment String?
  checkoutDate      DateTime?
  expectedReturnDate DateTime?
  returnedDate      DateTime?
  conditionOut      String?
  conditionIn       String?
  reason            String?
  notes             String?
  actor             String?
  createdAt         DateTime @default(now())

  asset             Asset    @relation(fields: [assetId], references: [customId], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([action, createdAt])
  @@map("asset_custody_events")
}

model AssetRelationship {
  id             String   @id @default(uuid())
  assetId        String
  relatedAssetId String
  relationshipType String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asset          Asset    @relation("AssetRelationshipFrom", fields: [assetId], references: [customId], onDelete: Cascade)
  relatedAsset   Asset    @relation("AssetRelationshipTo", fields: [relatedAssetId], references: [customId], onDelete: Cascade)

  @@index([assetId, relationshipType])
  @@index([relatedAssetId, relationshipType])
  @@unique([assetId, relatedAssetId, relationshipType])
  @@map("asset_relationships")
}

model SpareStockItem {
  id                     String   @id @default(uuid())
  partName               String
  componentType          String
  category               String?
  brand                  String?
  model                  String?
  partNumber             String?
  quantityAvailable      Int      @default(0)
  minimumStockLevel      Int      @default(0)
  reorderPoint           Int?
  safetyStock            Int?
  annualDemand           Int?
  orderingCost           Decimal?
  holdingCost            Decimal?
  minimumOrderQuantity   Int?
  minimumOrderValue      Decimal?
  packSize               Int?
  leadTimeDays           Int?
  abcClass               InventoryAbcClass @default(UNCLASSIFIED)
  abcReason              String?
  location               String?
  vendor                 String?
  unitCost               Decimal?
  compatibleAssetTypes   Json?
  compatibleBrandsModels Json?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  stockBatches           InventoryStockBatch[]

  @@index([componentType])
  @@index([partNumber])
  @@index([quantityAvailable, minimumStockLevel])
  @@index([abcClass])
  @@map("spare_stock_items")
}

model AssetSpecSnapshot {
  id                 String    @id @default(uuid())
  assetId            String
  normalizedSpecs    Json      @default("{}")
  lookupMode         String    @default("unknown")
  verificationStatus String    @default("pending")
  confidence         Float?
  evidenceStatus     String    @default("insufficient_source_evidence")
  evidenceReason     String?
  provider           String?
  ruleVersion        String?
  variant            String?
  snapshotHash       String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset        Asset               @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  evidenceRows AssetSpecEvidence[]

  @@index([assetId, createdAt])
  @@index([verificationStatus])
  @@index([evidenceStatus])
  @@index([snapshotHash])
  @@map("asset_spec_snapshots")
}

model AssetSpecEvidence {
  id               String    @id @default(uuid())
  snapshotId       String
  assetId          String
  provider         String?
  sourceUrl        String
  sourceDomain     String?
  fetchedAt        DateTime?
  contentHash      String?
  extractedFields  Json?
  sourceConfidence Float?
  isTrusted        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  snapshot AssetSpecSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset    Asset             @relation(fields: [assetId], references: [customId], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([sourceDomain])
  @@index([fetchedAt])
  @@index([contentHash])
  @@map("asset_spec_evidence")
}

model AssetTelemetrySample {
  id                 String   @id @default(uuid())
  assetId            String
  observedAt         DateTime
  telemetrySource    String
  rawSignals         Json     @default("{}")
  derivedStatus      String
  confidence         Float?
  reason             String?
  activeHours        Float?
  idleHours          Float?
  offlineHours       Float?
  utilization        Json?
  consumptionScore   Float?
  qualityImpactScore Float?
  sampleHash         String?
  createdAt          DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [customId], onDelete: Cascade)

  @@index([assetId, observedAt])
  @@index([derivedStatus, observedAt])
  @@index([telemetrySource, observedAt])
  @@index([sampleHash])
  @@map("asset_telemetry_samples")
}

model AssetLifespanPrediction {
  id                     String    @id @default(uuid())
  assetId                String
  predictedLifespanYears Float
  predictedEolDate       DateTime?
  monthsRemaining        Float?
  failureRisk            Float?
  qualityTier            String?
  confidence             Float?
  evidenceLevel          String?
  modelVersion           String?
  predictionSource       String
  trigger                String
  reason                 String?
  explanation            String?
  workingHours           Float?
  operationalState       String?
  telemetryStatus        String?
  specEvidenceStatus     String?
  isDisplayOnly          Boolean   @default(false)
  previousPredictionId   String?
  deltaLifespanYears     Float?
  deltaMonthsRemaining   Float?
  generatedBy            String?
  provider               String?
  requestId              String?
  createdAt              DateTime  @default(now())

  asset              Asset                     @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  previousPrediction AssetLifespanPrediction?  @relation("LifespanPredictionHistory", fields: [previousPredictionId], references: [id], onDelete: SetNull)
  nextPredictions    AssetLifespanPrediction[] @relation("LifespanPredictionHistory")

  @@index([assetId, createdAt])
  @@index([trigger, createdAt])
  @@index([isDisplayOnly, createdAt])
  @@index([requestId])
  @@map("asset_lifespan_predictions")
}

model AssetEolAssessment {
  id                             String    @id @default(uuid())
  assetId                        String
  status                         String
  predictedEolDate               DateTime?
  monthsRemaining                Float?
  confidence                     Float
  reason                         String
  evidenceLevel                  String
  predictionSource               String
  telemetryStatus                String
  specEvidenceStatus             String
  suitableForProcurementPlanning Boolean   @default(false)
  procurementRecommended         Boolean   @default(false)
  procurementWindowMonths        Int?
  generatedAt                    DateTime
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  asset                 Asset                       @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  procurementCandidates AssetProcurementCandidate[]

  @@index([assetId, generatedAt])
  @@index([status, confidence])
  @@index([procurementRecommended, procurementWindowMonths])
  @@map("asset_eol_assessments")
}

model AssetProcurementCandidate {
  id                      String    @id @default(uuid())
  assetId                 String
  eolAssessmentId         String?
  candidateStatus         String    @default("open")
  predictedEolDate        DateTime?
  confidence              Float?
  reason                  String?
  procurementWindowMonths Int?
  recommendedAt           DateTime  @default(now())
  acknowledgedAt          DateTime?
  acknowledgedBy          String?
  dismissedAt             DateTime?
  dismissedBy             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  asset         Asset               @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  eolAssessment AssetEolAssessment? @relation(fields: [eolAssessmentId], references: [id], onDelete: SetNull)

  @@index([assetId, candidateStatus])
  @@index([candidateStatus, recommendedAt])
  @@map("asset_procurement_candidates")
}

model ProcurementRequest {
  id                 String                     @id @default(uuid())
  requestNumber      String                     @unique
  title              String
  description        String?
  requestType        ProcurementRequestType     @default(OTHER)
  priority           ProcurementRequestPriority @default(MEDIUM)
  status             ProcurementRequestStatus   @default(DRAFT)
  reason             String
  requestedBy        String
  department         String?
  building           String?
  room               String?
  neededByDate       DateTime?
  estimatedBudget    Decimal?
  actualCost         Decimal?
  abcClass           InventoryAbcClass          @default(UNCLASSIFIED)
  abcReason          String?
  controlLevel       String?
  financeStatus      ProcurementFinanceStatus   @default(NOT_SUBMITTED)
  costCenterId       String?
  budgetAllocationId String?
  budgetAmountReserved Decimal?
  financeNotes       String?
  financeMetadata    Json?
  source             ProcurementRequestSource   @default(MANUAL)
  aiRecommendationId String?
  metadata           Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  items              ProcurementRequestItem[]
  approvals          ProcurementApproval[]
  vendorQuotes       VendorQuote[]
  purchaseOrders     PurchaseOrder[]
  receivingRecords   ReceivingRecord[]
  assetLinks         ProcurementAssetLink[]
  recommendationReviews ProcurementRecommendationReview[]
  costCenter         CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  budgetAllocation   BudgetAllocation?          @relation(fields: [budgetAllocationId], references: [id], onDelete: SetNull)
  rfqs               ProcurementRfq[]
  invoices           ProcurementInvoice[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([source, createdAt])
  @@index([department])
  @@index([building])
  @@index([abcClass])
  @@index([financeStatus])
  @@index([costCenterId])
  @@index([budgetAllocationId])
  @@map("procurement_requests")
}

model ProcurementRequestItem {
  id                String   @id @default(uuid())
  requestId         String
  itemName          String
  category          String?
  assetType         String?
  brand             String?
  model             String?
  specifications    Json?
  quantityRequested Int
  quantityApproved  Int?
  quantityOrdered   Int?
  quantityReceived  Int      @default(0)
  unitEstimatedCost Decimal?
  unitActualCost    Decimal?
  annualDemand      Int?
  orderingCost      Decimal?
  holdingCost       Decimal?
  calculatedEoq     Decimal?
  recommendedOrderQuantity Int?
  reorderPointValue Int?
  safetyStock       Int?
  demandSource      String?
  dataQuality       String?
  minimumOrderQuantity Int?
  minimumOrderValue Decimal?
  packSize          Int?
  leadTimeDays      Int?
  abcClass          InventoryAbcClass @default(UNCLASSIFIED)
  abcReason         String?
  linkedAssetTag    String?
  linkedSpareStockId String?
  linkedConsumableId String?
  linkedLicenseId   String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request           ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  receivingItems    ReceivingRecordItem[]
  invoiceLines      ProcurementInvoiceLine[]

  @@index([requestId, createdAt])
  @@index([linkedAssetTag])
  @@index([linkedSpareStockId])
  @@index([category])
  @@index([abcClass])
  @@map("procurement_request_items")
}

model ProcurementApproval {
  id          String                     @id @default(uuid())
  requestId   String
  fromStatus  ProcurementRequestStatus?
  toStatus    ProcurementRequestStatus
  decision    ProcurementApprovalDecision
  decidedBy   String
  decisionNote String?
  createdAt   DateTime                   @default(now())

  request     ProcurementRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([toStatus, createdAt])
  @@map("procurement_approvals")
}

model Vendor {
  id               String   @id @default(uuid())
  name             String
  contactName      String?
  email            String?
  phone            String?
  address          String?
  categoriesSupplied Json?
  leadTimeAverageDays Int?
  warrantyQualityScore Float?
  active           Boolean  @default(true)
  reliabilityScore Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quotes           VendorQuote[]
  purchaseOrders   PurchaseOrder[]
  catalogItems     SupplierCatalogItem[]
  rfqInvitations   ProcurementRfqInvitation[]
  invoices         ProcurementInvoice[]

  @@index([name])
  @@index([active])
  @@map("procurement_vendors")
}

model VendorQuote {
  id              String           @id @default(uuid())
  requestId       String
  vendorId        String?
  vendorName      String
  quotedItem      String
  quantity        Int
  unitPrice       Decimal?
  totalPrice      Decimal?
  currency        String           @default("USD")
  minimumOrderQuantity Int?
  minimumOrderValue Decimal?
  packSize        Int?
  leadTimeDays    Int?
  bulkDiscountAvailable Boolean?
  warrantyMonths  Int?
  deliveryDays    Int?
  validUntil      DateTime?
  status          VendorQuoteStatus @default(PENDING)
  rejectionReason String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  request         ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor          Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([requestId, status])
  @@index([vendorId])
  @@index([createdAt])
  @@map("procurement_vendor_quotes")
}

model PurchaseOrder {
  id                  String             @id @default(uuid())
  poNumber            String             @unique
  requestId           String
  vendorId            String?
  vendorName          String
  status              PurchaseOrderStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  issuedAt            DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  request             ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor              Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items               PurchaseOrderItem[]
  receivingRecords    ReceivingRecord[]
  invoices            ProcurementInvoice[]

  @@index([requestId, status])
  @@index([vendorId])
  @@index([createdAt])
  @@map("procurement_purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  requestItemId    String?
  itemName         String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Decimal?
  totalPrice       Decimal?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requestItem      ProcurementRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  receivingItems   ReceivingRecordItem[]
  invoiceLines     ProcurementInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([requestItemId])
  @@map("procurement_purchase_order_items")
}

model InventoryStockBatch {
  id                  String   @id @default(uuid())
  itemKind            String
  spareStockItemId    String?
  consumableAssetId   String?
  itemName            String
  batchCode           String?
  receivedAt          DateTime @default(now())
  quantityReceived    Int
  quantityAvailable   Int
  unitCost            Decimal?
  vendor              String?
  location            String?
  warrantyEndDate     DateTime?
  expiryDate          DateTime?
  sourceRequestId     String?
  sourcePurchaseOrderId String?
  notes               String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  spareStockItem      SpareStockItem?         @relation(fields: [spareStockItemId], references: [id], onDelete: SetNull)
  movements           InventoryStockMovement[]

  @@index([itemKind, receivedAt])
  @@index([spareStockItemId, receivedAt])
  @@index([consumableAssetId, receivedAt])
  @@index([quantityAvailable])
  @@map("inventory_stock_batches")
}

model InventoryStockMovement {
  id                String   @id @default(uuid())
  batchId           String
  movementType      String
  quantity          Int
  reason            String?
  referenceType     String?
  referenceId       String?
  actor             String?
  createdAt         DateTime @default(now())

  batch             InventoryStockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([movementType, createdAt])
  @@map("inventory_stock_movements")
}

model ReceivingRecord {
  id             String             @id @default(uuid())
  requestId      String
  purchaseOrderId String?
  receivedBy     String
  receivedAt     DateTime           @default(now())
  condition      ReceivingCondition @default(GOOD)
  notes          String?
  createdAt      DateTime           @default(now())

  request        ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items          ReceivingRecordItem[]

  @@index([requestId, receivedAt])
  @@index([purchaseOrderId, receivedAt])
  @@map("procurement_receiving_records")
}

model ReceivingRecordItem {
  id                     String   @id @default(uuid())
  receivingRecordId      String
  purchaseOrderItemId    String?
  requestItemId          String?
  itemName               String
  quantityReceived       Int
  createdAssetIds        Json?
  spareStockUpdated      Boolean  @default(false)
  spareStockId           String?
  consumableUpdated      Boolean  @default(false)
  consumableId           String?
  licenseCreatedOrUpdated Boolean @default(false)
  licenseId              String?
  notes                  String?
  createdAt              DateTime @default(now())

  receivingRecord        ReceivingRecord      @relation(fields: [receivingRecordId], references: [id], onDelete: Cascade)
  purchaseOrderItem      PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  requestItem            ProcurementRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  @@index([receivingRecordId])
  @@index([purchaseOrderItemId])
  @@index([requestItemId])
  @@map("procurement_receiving_record_items")
}

model ProcurementAssetLink {
  id               String                           @id @default(uuid())
  requestId        String
  assetId          String?
  assetTag         String?
  relationshipType ProcurementAssetRelationshipType @default(RELATED_TO)
  createdAt        DateTime                         @default(now())

  request          ProcurementRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([assetId])
  @@index([assetTag])
  @@index([relationshipType])
  @@map("procurement_asset_links")
}

model ProcurementRecommendationReview {
  id                 String                              @id @default(uuid())
  recommendationKey  String
  itemName           String
  source             String
  priority           String
  evidence           Json?
  status             ProcurementRecommendationReviewStatus @default(NEW)
  convertedRequestId String?
  reviewedBy         String?
  reviewNote         String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt

  convertedRequest   ProcurementRequest?                @relation(fields: [convertedRequestId], references: [id], onDelete: SetNull)

  @@unique([recommendationKey])
  @@index([status, createdAt])
  @@index([source])
  @@map("procurement_recommendation_reviews")
}

model CostCenter {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  department       String?
  owner            String?
  annualBudget     Decimal?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  allocations      BudgetAllocation[]
  procurementRequests ProcurementRequest[]

  @@index([active])
  @@index([department])
  @@map("finance_cost_centers")
}

model BudgetPeriod {
  id               String   @id @default(uuid())
  label            String   @unique
  startDate        DateTime
  endDate          DateTime
  status           String   @default("open")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  allocations      BudgetAllocation[]

  @@index([status])
  @@map("finance_budget_periods")
}

model BudgetAllocation {
  id               String   @id @default(uuid())
  periodId         String
  costCenterId     String
  department       String?
  building         String?
  allocatedAmount  Decimal
  reservedAmount   Decimal  @default(0)
  committedAmount  Decimal  @default(0)
  spentAmount      Decimal  @default(0)
  currency         String   @default("USD")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  period           BudgetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  costCenter       CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  usages           BudgetUsage[]
  procurementRequests ProcurementRequest[]

  @@index([periodId, costCenterId])
  @@index([department, building])
  @@map("finance_budget_allocations")
}

model BudgetUsage {
  id               String   @id @default(uuid())
  allocationId     String
  requestId        String?
  usageType        String
  amount           Decimal
  note             String?
  actor            String?
  createdAt        DateTime @default(now())

  allocation       BudgetAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId, createdAt])
  @@index([usageType])
  @@map("finance_budget_usages")
}

model ProcurementInvoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique
  requestId        String
  purchaseOrderId  String?
  vendorId         String?
  vendorName       String
  invoiceDate      DateTime?
  dueDate          DateTime?
  status           String   @default("draft")
  totalAmount      Decimal?
  currency         String   @default("USD")
  paymentStatus    String   @default("not_submitted")
  notes            String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  request          ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  vendor           Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  lines            ProcurementInvoiceLine[]

  @@index([requestId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([paymentStatus])
  @@map("procurement_invoices")
}

model ProcurementInvoiceLine {
  id               String   @id @default(uuid())
  invoiceId        String
  requestItemId    String?
  purchaseOrderItemId String?
  itemName         String
  quantity         Int      @default(1)
  unitPrice        Decimal?
  totalPrice       Decimal?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice          ProcurementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestItem      ProcurementRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([requestItemId])
  @@index([purchaseOrderItemId])
  @@map("procurement_invoice_lines")
}

model SupplierCatalogItem {
  id               String   @id @default(uuid())
  vendorId         String
  itemName         String
  category         String?
  assetType        String?
  brand            String?
  model            String?
  specifications   Json?
  unitPrice        Decimal?
  currency         String   @default("USD")
  minimumOrderQuantity Int?
  minimumOrderValue Decimal?
  packSize         Int?
  leadTimeDays     Int?
  warrantyMonths   Int?
  active           Boolean  @default(true)
  lastUpdatedAt    DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, active])
  @@index([category, itemName])
  @@map("procurement_supplier_catalog_items")
}

model ProcurementRfq {
  id               String   @id @default(uuid())
  rfqNumber        String   @unique
  requestId        String
  title            String
  description      String?
  quoteDueDate     DateTime?
  status           ProcurementRfqStatus @default(DRAFT)
  createdBy        String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  request          ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  invitations      ProcurementRfqInvitation[]

  @@index([requestId, status])
  @@map("procurement_rfqs")
}

model ProcurementRfqInvitation {
  id               String   @id @default(uuid())
  rfqId            String
  vendorId         String?
  vendorName       String
  invitedAt        DateTime @default(now())
  responseStatus   String   @default("pending")
  submittedQuoteId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rfq              ProcurementRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([rfqId, responseStatus])
  @@index([vendorId])
  @@map("procurement_rfq_invitations")
}

model InventoryAiJob {
  id             String    @id @default(uuid())
  jobType        String
  assetId        String
  status         String    @default("queued")
  payload        Json      @default("{}")
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  maxAttempts    Int       @default(4)
  lastError      String?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  parentJobId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset     Asset            @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  parentJob InventoryAiJob?  @relation("InventoryAiJobParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs InventoryAiJob[] @relation("InventoryAiJobParent")

  @@index([assetId, createdAt])
  @@index([jobType, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("inventory_ai_jobs")
}

model AssetLifecycleOutcome {
  id                  String    @id @default(uuid())
  assetId             String    @unique
  purchaseDate        DateTime?
  commissionedAt      DateTime?
  failureDate         DateTime?
  replacementDate     DateTime?
  retiredAt           DateTime?
  failureType         String?
  replacementCost     Decimal?
  actualLifespanYears Float?
  finalOutcome        String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [customId], onDelete: Cascade)

  @@map("asset_lifecycle_outcomes")
}

model AssetHistory {
  id      String   @id @default(uuid())
  assetId String
  event   String
  details String
  date    DateTime @default(now())

  // Relation
  asset Asset @relation(fields: [assetId], references: [customId], onDelete: Cascade)

  @@map("asset_embedded_history")
}

model Ticket {
  id           String         @id @default(uuid())
  title        String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  type         TicketType     @default(OTHER)
  assignedTo   String?
  relatedAsset String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  asset        Asset?        @relation(fields: [relatedAsset], references: [customId])
  assetTickets AssetTicket[]

  @@map("tickets")
}

model AssetTicket {
  assetId  String
  ticketId String

  // Relations
  asset  Asset  @relation(fields: [assetId], references: [customId], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([assetId, ticketId])
  @@map("asset_tickets")
}
