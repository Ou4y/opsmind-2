{
  "name": "opsmind-backend",
  "version": "1.0.0",
  "description": "Asset Management Microservice",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "api": "ts-node src/server.ts",
    "worker": "ts-node src/worker.ts",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate:prod": "prisma migrate deploy",
    "backfill:phase3:dry": "ts-node scripts/backfill_inventory_ai_phase3.ts",
    "backfill:phase3:write": "ts-node scripts/backfill_inventory_ai_phase3.ts --write",
    "readiness:report": "ts-node scripts/readiness_report.ts",
    "warmup:source-cache": "ts-node scripts/warmup_source_specs_cache.ts",
    "dev": "concurrently \"npm run api\" \"npm run worker\" --names \"API,WORKER\" --prefix-colors \"blue,magenta\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "amqplib": "^0.10.3",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "9.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
