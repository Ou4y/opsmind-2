PORT=3004
NODE_ENV=development
DATABASE_URL=mysql://<db_user>:<db_password>@mysql:3306/sla_db
RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@rabbitmq:5672

# Security secrets
JWT_SECRET=__SET_STRONG_JWT_SECRET__
INTERNAL_API_TOKEN=__SET_STRONG_INTERNAL_API_TOKEN__

# CORS
ALLOWED_ORIGINS=http://localhost:8085
CORS_ALLOW_CREDENTIALS=false

# API docs and request limits
ENABLE_API_DOCS=true
JSON_BODY_LIMIT=1mb

RABBITMQ_SLA_EXCHANGE=opsmind.sla.exchange
RABBITMQ_NOTIFICATION_WARNING_KEY=ticket.notification.slaWarning
RABBITMQ_NOTIFICATION_BREACH_KEY=ticket.notification.slaBreached
SLA_CHECK_INTERVAL_MS=60000
SLA_AUTO_REQUEST_WORKFLOW_ON_RESPONSE_BREACH=false
SLA_AUTO_REQUEST_WORKFLOW_ON_RESOLUTION_BREACH=false
