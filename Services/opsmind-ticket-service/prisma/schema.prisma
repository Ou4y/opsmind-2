generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SupportLevel {
  L1
  L2
  L3
  L4
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RequestType {
  INCIDENT
  SERVICE_REQUEST
  MAINTENANCE
}

enum AssignmentMethod {
  AUTOMATIC
  MANUAL
  ADMIN
  ESCALATION
  WORKFLOW
  SYSTEM
}

model Ticket {
  id                 String           @id @default(uuid())
  title              String
  description        String           @db.Text
  type_of_request    RequestType      @default(INCIDENT) // ENUM
  requester_id       String           // UUID
  latitude           Float
  longitude          Float
  assigned_to        String?          // UUID, nullable
  assigned_to_level  SupportLevel     // ENUM
  priority           TicketPriority   // ENUM
  support_level      SupportLevel     // ENUM
  status             TicketStatus     // ENUM
  escalation_count   Int              @default(0)
  resolution_summary String?          @db.Text
  is_deleted         Boolean          @default(false)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  resolved_at        DateTime?        // nullable
  closed_at          DateTime?        // nullable

  escalations        TicketEscalation[]
  assignment_history TicketAssignmentHistory[]
  status_history     TicketStatusHistory[]

  @@index([status])
  @@index([priority])
  @@index([assigned_to])
  @@index([created_at])
}

model TicketEscalation {
  id          String       @id @default(uuid())
  ticket_id   String
  from_level  SupportLevel // ENUM
  to_level    SupportLevel // ENUM
  reason      String
  created_at  DateTime     @default(now())

  ticket      Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

model TicketAssignmentHistory {
  id                String           @id @default(uuid())
  ticket_id         String
  previous_assignee String?
  new_assignee      String?
  previous_level    SupportLevel?
  new_level         SupportLevel?
  method            AssignmentMethod
  reason            String?
  performed_by      String?
  performed_by_role String?
  created_at        DateTime         @default(now())

  ticket            Ticket           @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([new_assignee])
  @@index([performed_by])
}

model TicketStatusHistory {
  id                String       @id @default(uuid())
  ticket_id         String
  old_status        TicketStatus
  new_status        TicketStatus
  performed_by      String?
  performed_by_role String?
  reason            String?
  created_at        DateTime     @default(now())

  ticket            Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([new_status])
  @@index([performed_by])
}
