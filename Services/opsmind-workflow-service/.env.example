# Service Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=opsmind-workflow

# Security secrets
JWT_SECRET=__SET_STRONG_JWT_SECRET__
INTERNAL_API_TOKEN=__SET_STRONG_INTERNAL_API_TOKEN__

# CORS
ALLOWED_ORIGINS=http://localhost:8085
CORS_ALLOW_CREDENTIALS=false

# Docs/debug controls
ENABLE_API_DOCS=true
ENABLE_DEBUG_ROUTES=false
JSON_BODY_LIMIT=1mb

# MySQL Database Configuration
DB_HOST=opsmind-mysql
DB_PORT=3306
DB_USER=workflow_user
DB_PASSWORD=__SET_STRONG_WORKFLOW_DB_PASSWORD__
DB_NAME=workflow_db
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# External Services (Docker container names)
AUTH_SERVICE_URL=http://opsmind-auth-service:3002
TICKET_SERVICE_URL=http://opsmind-ticket-service:3000
SLA_SERVICE_URL=http://opsmind-sla-service:3004

# Logging
LOG_LEVEL=info

# SLA Configuration (in minutes)
SLA_CRITICAL=60
SLA_HIGH=120
SLA_MEDIUM=240
SLA_LOW=480

# Escalation Configuration
MAX_REASSIGNMENT_COUNT=2
AUTO_ESCALATE_ON_REOPEN_COUNT=3
