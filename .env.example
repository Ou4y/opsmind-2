# Frontend runtime configuration injected into opsmind_frontend/assets/js/config.js

# Backend service URLs
OPSMIND_API_URL=http://localhost:3012
OPSMIND_TICKET_URL=http://localhost:3001
OPSMIND_WORKFLOW_API_URL=http://localhost:3003
OPSMIND_AI_API_URL=http://localhost:8001
OPSMIND_INVENTORY_AI_API_URL=http://localhost:8002
OPSMIND_SLA_URL=http://localhost:3004
OPSMIND_NOTIFICATION_URL=http://localhost:3005/api/notifications
OPSMIND_INVENTORY_API_URL=http://localhost:5000/api
OPSMIND_REPORT_API_URL=http://localhost:3006/analytics
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SPEC_LOOKUP_TIMEOUT_SECONDS=8
SPEC_MAX_FETCH_BYTES=180000
SPEC_MAX_SEARCH_LINKS=5
SPEC_MAX_AUTHORITATIVE_LINKS=3
SPEC_RULE_VERSION_CONTROL=spec-rules-v1
SPEC_RULE_VERSION_CANDIDATE=spec-rules-v2
SPEC_AB_ROLLOUT_PERCENT=20
SPEC_FORCE_VARIANT=
SPEC_VERIFICATION_CONFIDENCE_THRESHOLD=0.85
SCHEDULER_POLL_SECONDS=60
SPEC_DAILY_HOUR_UTC=1
SPEC_DAILY_MINUTE_UTC=0
LIFESPAN_MONTHLY_DAY_UTC=1
LIFESPAN_MONTHLY_HOUR_UTC=2
LIFESPAN_MONTHLY_MINUTE_UTC=0

# Local Ollama configuration
# Ensure Ollama is running locally and the model is available:
#   ollama pull gemma3:4b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=45000
AI_DEBUG_RAW_OUTPUT=false
OLLAMA_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SPEC_HTTP_RETRY_ATTEMPTS=3
SPEC_HTTP_BACKOFF_SECONDS=0.35
SPEC_LOOKUP_CIRCUIT_FAILURES=4
SPEC_LOOKUP_CIRCUIT_RESET_SECONDS=90
SPEC_PROMOTION_MIN_EVALS=40
SPEC_PROMOTION_MIN_IMPROVEMENT=0.01
WEEKLY_RETRAIN_DAY_UTC=0
WEEKLY_RETRAIN_HOUR_UTC=3
WEEKLY_RETRAIN_MINUTE_UTC=0
PROXY_LABEL_WEIGHT=0.2

# Shared internal token for service-to-service auth
INTERNAL_API_TOKEN=opsmind-internal-dev-token

# Inventory backend auth toggle (set true to require JWT role checks for inventory APIs)
INVENTORY_ENFORCE_AUTH=false

# Inventory events / low-stock notifications
EVENTS_EXCHANGE_NAME=opsmind.events
INVENTORY_EVENTS_EXCHANGE=opsmind.events
LOW_STOCK_ADMIN_ID=456
LOW_STOCK_ADMIN_NAME=Omar
LOW_STOCK_ADMIN_EMAIL=omar@example.com
LIFESPAN_IMPACT_MIN_HOURS=2
LIFESPAN_IMPACT_MIN_YEAR_DELTA=0.1
LIFESPAN_IMPACT_MIN_RISK_DELTA=0.03
INVENTORY_AI_JOBS_EXCHANGE=opsmind.events
INVENTORY_AI_JOB_MAX_ATTEMPTS=4
INVENTORY_AI_JOB_RETRY_1_MS=30000
INVENTORY_AI_JOB_RETRY_2_MS=300000
INVENTORY_AI_JOB_RETRY_3_MS=1800000
INVENTORY_AI_JOB_CONSUMER_PREFETCH=4
INVENTORY_AI_JOB_RECOVERY_INTERVAL_MS=30000
INVENTORY_BACKEND_INTERNAL_URL=http://inventory-backend:5000

# Workflow queue/topic tuning
RABBITMQ_TICKET_ASSIGNED_QUEUE=ticket.assigned
RABBITMQ_TICKET_SYNC_QUEUE=workflow.ticket.sync
RABBITMQ_WORKFLOW_INTERVENTION_KEY=
TECHNICIAN_LOCATION_STALE_MINUTES=30
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=5000

# Notification local test-mode toggle
NO_DB=false
